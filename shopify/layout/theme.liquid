<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}" />{% endif %}
    <link rel="canonical" href="{{ canonical_url }}" />
    <link rel="icon" href="{{ settings.site_url }}/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.site_url }}/favicon-32.png" />
    <link rel="apple-touch-icon" href="{{ settings.site_url }}/apple-touch-icon.png" />
    <meta property="og:image" content="{{ settings.site_url }}/art/share.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400..700,100;1,9..144,400..600,100&family=Nunito:wght@400;600;800&display=swap" rel="stylesheet" />
    {{ 'style.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <header class="bar">
      <a class="studio" href="{{ settings.site_url }}/">emco studios</a>
      <nav>
        <a href="{{ settings.site_url }}/#story">The story</a>
        <a href="{{ settings.site_url }}/#author">The author</a>
        <a class="pill" href="/#buy" data-buy-label="short">Preorder</a>
      </nav>
    </header>

    <main id="top">
      {{ content_for_layout }}
    </main>

    <footer class="deep">
      <div class="deep-inner">
        <p class="deep-line">There’s a whole ocean out there<br />waiting for you…</p>
        <div class="deep-foot">
          <span>© {{ 'now' | date: '%Y' }} emco studios</span>
          <a class="ig" href="{{ settings.instagram_url }}" aria-label="Emco Studios on Instagram">{% render 'icon-instagram' %}<span>@emcostudios</span></a>
        </div>
      </div>
    </footer>

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
